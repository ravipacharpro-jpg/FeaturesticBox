<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Center Rotate Your Phone UI -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Smartphone Vector Outline -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_rotate_phone_outline">

            <!-- Dynamic Island / Speaker notch -->
            <View
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_rotate_phone_island" />
        </FrameLayout>

        <!-- Vertical Divider Line -->
        <View
            android:layout_width="2dp"
            android:layout_height="96dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="#FFFFFF" />

        <!-- ROTATE YOUR PHONE Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:lineSpacingExtra="3dp"
            android:text="ROTATE&#10;YOUR&#10;PHONE"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Bottom FeaturesticBox Branding -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.15"
        android:text="FeaturesticBox"
        android:textColor="#99FFFFFF"
        android:textSize="13sp" />

</FrameLayout>
