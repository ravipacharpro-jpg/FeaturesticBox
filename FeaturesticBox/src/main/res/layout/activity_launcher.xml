<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/featurestic_runtime_background">

    <View
        android:id="@+id/runtime_glow"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:background="@drawable/featurestic_runtime_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Top Security & 120Hz Status Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/featurestic_runtime_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="15dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/featurestic_runtime_status_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.13"
                android:text="FEATURESTIC ENGINE  •  120HZ PROTECTED SANDBOX"
                android:textColor="#FFE2E8F0"
                android:textSize="9sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Centerpiece 3D Vector/Canvas "F" Emblem (Zero Raster Photo) -->
        <FrameLayout
            android:layout_width="236dp"
            android:layout_height="236dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/brand_ring"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/featurestic_runtime_ring" />

            <FrameLayout
                android:id="@+id/brand_panel"
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                android:background="@drawable/featurestic_runtime_card"
                android:elevation="22dp"
                android:padding="12dp">

                <com.featurestic.box.app.FeaturesticRibbonFLogoView
                    android:id="@+id/iv_brand"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </FrameLayout>

        <!-- Brand Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.18"
            android:text="FEATURESTIC"
            android:textColor="#FFFFFFFF"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="120Hz Display Engine  •  Anti-Crack Vault  •  Log Shield"
            android:textColor="#FF94A3B8"
            android:textSize="10.5sp" />

        <!-- Live Hardware Capability Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/featurestic_runtime_chip"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="120 FPS LOCKED"
                android:textColor="#FF00F0FF"
                android:textSize="8.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/featurestic_runtime_chip"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="LOG WIPE ON"
                android:textColor="#FF30D158"
                android:textSize="8.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/featurestic_runtime_chip"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="GG RAM LOCK"
                android:textColor="#FFA855F7"
                android:textSize="8.5sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Target Game Identity Card -->
        <LinearLayout
            android:id="@+id/app_identity_card"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/featurestic_runtime_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_glow"
                android:contentDescription="Target application"
                android:padding="5dp"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="120Hz Hardware Mode  •  Isolated Container Ready"
                    android:textColor="#FF38BDF8"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_glow"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="120HZ READY"
                android:textColor="#FF30D158"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Telemetry Progress Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/runtime_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/featurestic_runtime_status_dot" />

            <TextView
                android:id="@+id/launch_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="LOCKING 120HZ DISPLAY &amp; SANDBOX ENGINE"
                android:textColor="#FFE2E8F0"
                android:textSize="9.5sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/launch_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="9dp"
            android:indeterminate="true"
            android:indeterminateTint="#FF00F0FF"
            android:progressBackgroundTint="#22FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:text="POWER + VOL+ MENU  &#8226;  ANTI-CRACK VAULT  &#8226;  120HZ LOCK"
            android:textColor="#FF64748B"
            android:textSize="8.5sp" />
    </LinearLayout>
</FrameLayout>
